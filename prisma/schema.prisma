generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id     Int     @id @default(autoincrement())
  nome   String
  email  String  @unique
  senha  String

  perfil Perfil?
}

model Perfil {
  id          Int     @id @default(autoincrement())
  perfil_nome String

  usuario     Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId   Int     @unique
}